# Public HTTPS URL for the tool — set to your cloudflared/ngrok tunnel hostname
APP_URL=https://example.trycloudflare.com

# LTI runs only when MONGODB_URL is set; LTI_KEY and CANVAS_ISSUER are then
# required as well. Leave all three unset to serve credential login alone.
#
# Random secret used by ltijs to sign internal cookies/JWTs (32+ bytes)
# Generate with: openssl rand -hex 32
LTI_KEY=replace-me

# MongoDB Atlas connection string (M0 free cluster is fine for dev)
MONGODB_URL=mongodb+srv://lti-server:<password>@<cluster>.mongodb.net/lti-server-dev?retryWrites=true&w=majority

# Canonical Instructure Cloud LTI issuer — same for ALL *.instructure.com tenants
CANVAS_ISSUER=https://canvas.instructure.com

# Our paid Instructure tenant URL (informational; some tools key off it)
CANVAS_TENANT_URL=https://blueprint.instructure.com

# Numeric Client ID from the Developer Key created at blueprint.instructure.com
CANVAS_CLIENT_ID=

# Public base URL embedded in /lti-config.json (the URL admins paste into Canvas).
# Optional — falls back to the inbound request's X-Forwarded-Host / Host header.
# Set this in prod to pin the URL regardless of proxy header drift.
# Example: https://canvas-lti-test.up.railway.app
PUBLIC_BASE_URL=

# --- LTI Dynamic Registration gate (step-12) -------------------------------
# Shared secret required by GET /lti/register. District admins paste
#   https://<host>/lti/register?registration_secret=<value>
# into Canvas; Canvas appends its own openid_configuration/registration_token.
# UNSET = dynamic registration is DISABLED (the endpoint 503s). Fail closed.
# Generate with: openssl rand -hex 32
LTI_REGISTRATION_SECRET=

# Comma-separated hosts allowed as the target of the openid_configuration
# (and registration_endpoint) fetch. Suffix-matched, https only.
# Defaults to instructure.com, canvaslms.com and the CANVAS_ISSUER host.
LTI_REGISTRATION_ALLOWED_HOSTS=

# --- LTI launch validation (step-12) ---------------------------------------
# Comma-separated deployment_id values accepted at /lti/validate. Unset means
# "any non-empty deployment_id"; pin it in prod so a token minted for another
# deployment of a registered (issuer, client_id) pair cannot open a session.
LTI_ALLOWED_DEPLOYMENT_IDS=

# BP AI GraphQL Gateway endpoint (consumer API — login/signup/refreshToken/logout).
# Your provider gives you the base URL per environment. Test environment:
# https://api-test.blueprinteq.ai/graphql  (GraphiQL playground at /graphiql)
BP_AI_GRAPHQL_URL=

# Secret used to sign the `bp-session` cookie (the BP AI credential session).
# MUST be a different value from LTI_KEY — the LTI session and the BP AI session
# are deliberately separate, and a shared secret is the one way they could
# cross-authenticate. The code refuses to sign if the two are equal.
# Generate with: openssl rand -hex 32
BP_SESSION_SECRET=replace-me

# Self-service signup — OFF unless explicitly enabled. Accepts 1 / true / yes / on;
# ANY other value (including "false") leaves it off, as does leaving it unset.
#
# `/signup` is fully built but deliberately dormant, and NOT because of a bug.
# The gateway's `signup` is an ORG-CREATION flow: every self-service signup
# provisions a brand-new empty tenant and makes the signer its `role: "admin"`
# (measured — five signups produced five distinct tenants, each with an admin
# claim). A student signing up here would end up owning an empty school with
# admin rights over it. What the product actually needs — a student joining an
# EXISTING school tenant — has no operation in this schema yet, so flipping this
# on is a backend conversation, not a config change.
#
# The flag gates the route's `action` as well as its UI, so a hand-crafted
# POST /signup cannot create a tenant while it is off. Both the loader and the
# action answer 404 when disabled.
BP_SIGNUP_ENABLED=

# Port of the HTTP server (the Kubernetes chart sets 10001).
SERVER_HTTP_PORT=3000

# Prometheus listener (GET /metrics), started only when NODE_ENV=production, on a
# port the Kubernetes Service does not publish.
METRICS_PORT=9090
